public class kadansalgo{
      //simple kadans algo(for positive or negative both mixed no)
    public static int kadans(int[] arr){
        int currsum = 0;
        int maxsum = Integer.MIN_VALUE;
        for(int i=0;i<=arr.length-1;i++){
            currsum+=arr[i];
            if(currsum < 0){
                currsum =0;
            }
            maxsum = Math.max(maxsum, currsum);
        }
        return maxsum;
    }
    //kadanes opt(for all positive, all negative, and mixed)
    public static int kadopt(int[] arr){
        int cs = arr[0];
        int ms = arr[0];
        for(int i=1;i<arr.length;i++){
            cs = Math.max(arr[i], cs+arr[i]);
            ms = Math.max(ms, cs);
        }
        return ms;
    }
    public static void main(String[] args) {
    int[] arr = {-2,-1,-3,-4,-1,-2,-1,-5,-4};
    System.out.println(kadopt(arr));
    System.out.println();
    }
    }
    


